<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.bassstrings</groupId>
  <artifactId>bass-strings-database</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>bass-strings-database</name>
  <description>Subscription community for bass players to review and discover bass strings</description>
  <packaging>jar</packaging>

  <properties>
    <java.version>25</java.version>
    <openapi.spec>${project.basedir}/openapi/bassstrings-api.yaml</openapi.spec>
    <openapi-generator.version>7.25.0</openapi-generator.version>
    <swagger-annotations.version>2.2.27</swagger-annotations.version>
  </properties>

  <dependencies>
    <!-- Web + templating -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!-- Security / OAuth2 login (Google, Facebook, Apple) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <!-- Brings Nimbus JOSE+JWT, used to mint Apple's ES256 client_secret JWT -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <!-- Renders sec:authorize / sec:authentication in Thymeleaf templates -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- OpenAPI-generated interfaces/models reference swagger annotations -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>${swagger-annotations.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Source: https://mvnrepository.com/artifact/org.projectlombok/lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.48</version>
      <scope>compile</scope>
    </dependency>
    <!-- Source: https://mvnrepository.com/artifact/com.github.ekryd.sortpom/sortpom-maven-plugin -->
    <dependency>
      <groupId>com.github.ekryd.sortpom</groupId>
      <artifactId>sortpom-maven-plugin</artifactId>
      <version>4.0.0</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>bass-strings-database</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Contract-first: generate API interfaces + DTOs from openapi/bassstrings-api.yaml
           before compilation. We hand-write @RestController classes that implement the
           generated *Api interfaces (interfaceOnly=true below), and a Mongo-backed domain
           model underneath, kept deliberately separate from these generated DTOs. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-bassstrings-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <inputSpec>${openapi.spec}</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.bassstrings.database.api</apiPackage>
              <modelPackage>com.bassstrings.database.api.model</modelPackage>
              <invokerPackage>com.bassstrings.database.api.invoker</invokerPackage>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <!-- Registers ${output}/src/main/java as a compile source root automatically -->
              <addCompileSourceRoot>true</addCompileSourceRoot>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useTags>true</useTags>
                <useSpringBoot3>true</useSpringBoot3>
                <dateLibrary>java8</dateLibrary>
                <openApiNullable>false</openApiNullable>
                <performBeanValidation>true</performBeanValidation>
                <useJakartaEe>true</useJakartaEe>
                <documentationProvider>none</documentationProvider>
                <generateJsonIncludeAnnotations>true</generateJsonIncludeAnnotations>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
